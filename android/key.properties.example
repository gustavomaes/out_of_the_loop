# Copie para key.properties e preencha com os valores do seu keystore.
# key.properties e *.jks estão no .gitignore — nunca commite esses arquivos.
#
# Gere o keystore (uma vez):
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias upload
#
# Coloque upload-keystore.jks nesta pasta (android/).

storePassword=SUA_SENHA_DO_KEYSTORE
keyPassword=SUA_SENHA_DA_CHAVE
keyAlias=upload
storeFile=../upload-keystore.jks
